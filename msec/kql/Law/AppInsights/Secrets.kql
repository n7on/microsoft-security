// Credential-shaped strings in Application Insights and App Service telemetry - where a secret
// has been written into a log, and which application wrote it.
//
// Loaded by Search-MsecLogAnalytics -Subject AppInsights -Name Secrets -WorkspaceName <ws>.
// Find the workspace to point it at with:
//   Search-MsecAzureResourceGraph -ResourceType ApplicationInsights |
//       Group-Object WorkspaceName | Sort-Object Count -Descending
//
// THIS REPORTS WHERE A SECRET IS, NEVER WHAT IT IS. A query that returned the matching line
// would move every secret it found into a console scrollback, an exported CSV, a ticket and a
// chat transcript - multiplying the exposure it was run to measure. So the only thing projected
// from the match is its SHAPE: the first six characters, which are the pattern's own literal
// prefix ('eyJhbG' is the base64 of every JWT header, 'passwo' is the word), plus the length.
// DistinctValues counts how many different secrets hide behind an occurrence count, which is
// what tells one leaked token logged a thousand times from a thousand leaked tokens.
//
// To see an actual value you have to open that resource's logs in the portal deliberately. That
// friction is the point.
//
// A MATCH IS NOT A BREACH AND A CLEAN RESULT IS NOT SAFETY. These are regexes over free text:
//   * 'password=' in an exception message may be a connection string or may be a form field
//     name with the value already masked by the application.
//   * A JWT in a URL is a real finding regardless of what it grants - URLs are logged by
//     proxies, browsers, referrer headers and here, so the token has already travelled further
//     than its holder intended.
//   * Nothing here detects a secret that was logged WITHOUT a recognisable label. A bare
//     40-character key printed on its own line matches nothing below.
//
// -Days IS THE COST CONTROL, AND IT IS NOT FREE. These tables are enormous - measured on one
// workspace, AppServiceConsoleLogs alone takes 5.8 million rows a day - and this query reads
// free text across six of them. One day is a few seconds; thirty days is a scan to run
// deliberately, not by habit.
//
// The window is NOT baked in here on purpose: a file-level time filter intersects silently
// with the one the caller asked for, so -Days 30 would quietly return one day. The repo has a
// test that fails any Law query containing ago() for exactly that reason.
//
// isfuzzy=true so a workspace missing any one of these tables still returns the others. A
// workspace with no App Service logging at all is a normal thing, not an error.

// ONE BRANCH PER COLUMN, NEVER A CONCATENATION. An earlier version merged CsUriQuery and
// Cookie into one haystack and labelled every hit 'CsUriQuery'. Every JWT it found was
// actually in the Cookie header - a normal place for a session token - and the report said
// they were in URLs, which is a far more serious and entirely different finding. If the
// Column value is not the column the match came from, the output is worse than nothing.
union isfuzzy=true
  (AppServiceConsoleLogs | extend Col='ResultDescription', Txt=ResultDescription),
  (AppServiceAppLogs     | extend Col='ResultDescription', Txt=ResultDescription),
  (AppServiceAppLogs     | extend Col='Message',           Txt=Message),
  (AppServiceAppLogs     | extend Col='StackTrace',        Txt=StackTrace),
  (AppExceptions         | extend Col='Message',           Txt=Message),
  (AppExceptions         | extend Col='OuterMessage',      Txt=OuterMessage),
  (AppExceptions         | extend Col='InnermostMessage',  Txt=InnermostMessage),
  (AppRequests           | extend Col='Url',               Txt=Url),
  (AppDependencies       | extend Col='Data',              Txt=Data),
  (AppDependencies       | extend Col='Target',            Txt=Target),
  (AppServiceHTTPLogs    | extend Col='CsUriQuery',        Txt=CsUriQuery),
  (AppServiceHTTPLogs    | extend Col='Cookie',            Txt=Cookie)
| where isnotempty(Txt)
// One extract per pattern with a CONSTANT regex. extract() cannot take a computed pattern -
// selecting one with case() fails at parse time with SEM0040 - so the patterns are listed once
// here and the first non-empty wins below.
| extend
    H_Pem  = extract(@'(-----BEGIN [A-Z ]*PRIVATE KEY-----)', 1, Txt),
    // \b anchors matter here: base64 blobs contain these prefixes as substrings, and without
    // the boundary an ASP.NET auth cookie reports as a leaked GitHub or npm token.
    H_Jwt  = extract(@'\b(eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.)', 1, Txt),
    H_Akey = extract(@'(?i)(accountkey=[A-Za-z0-9+/=]{40,})', 1, Txt),
    H_Aws  = extract(@'\b(AKIA[0-9A-Z]{16})\b', 1, Txt),
    H_Sas  = extract(@'(?i)([?&]sig=[A-Za-z0-9%+/=]{20,})', 1, Txt),
    H_Pwd  = extract(@'(?i)((?:password|pwd)=[^\s;"]{4,})', 1, Txt),
    H_Csec = extract(@'(?i)(client_secret=[^\s&"]{8,})', 1, Txt),
    H_Api  = extract(@'(?i)((?:api[_-]?key|x-api-key)["\:= ]+[A-Za-z0-9_-]{16,})', 1, Txt),
    H_Bear = extract(@'(?i)(bearer\s+[A-Za-z0-9._~+/-]{20,})', 1, Txt),
    H_Ikey = extract(@'(?i)(instrumentationkey=[0-9a-f-]{36})', 1, Txt)
// Ordered by how little doubt there is about the finding, not alphabetically: a PEM private key
// or a storage account key in a log is unambiguous, 'password=' is sometimes a field name.
| extend Pattern = case(
    isnotempty(H_Pem),  'PrivateKeyPem',
    isnotempty(H_Jwt),  'JwtToken',
    isnotempty(H_Akey), 'StorageAccountKey',
    isnotempty(H_Aws),  'AwsAccessKeyId',
    isnotempty(H_Sas),  'SasSignature',
    isnotempty(H_Csec), 'ClientSecret',
    isnotempty(H_Pwd),  'PasswordAssignment',
    isnotempty(H_Api),  'ApiKey',
    isnotempty(H_Bear), 'BearerToken',
    isnotempty(H_Ikey), 'InstrumentationKey',
    '')
| where isnotempty(Pattern)
| extend Hit = coalesce(H_Pem,H_Jwt,H_Akey,H_Aws,H_Sas,H_Csec,H_Pwd,H_Api,H_Bear,H_Ikey)
// The redaction. See the note above for why nothing more than this is projected.
| extend Shape = strcat(substring(Hit,0,6), '<', tostring(strlen(Hit)), ' chars redacted>')
| summarize Occurrences=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated),
            DistinctValues=dcount(Hit), ExampleShape=any(Shape)
          by Pattern, Table=Type, Column=Col, Resource=tostring(split(_ResourceId,'/')[-1])
| order by Occurrences desc
